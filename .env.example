# MySQL 连接示例
# 使用具有建库权限的账号
MYSQL_URL=
# 可选：当 MYSQL_URL 不含数据库名时使用
MYSQL_DB=beer_pub

# JWT
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=120

# Storage
STORAGE_PATH=storage

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_GEO_KEY=pub_geo

# AMap
AMAP_KEY=your_amap_key

# SMS (阿里云号码认证 SendSmsVerifyCode)
# 签名和模板需使用号码认证控制台的赠送签名/赠送模板

SMS_MOCK=true
ALI_ACCESS_KEY_ID=
ALI_ACCESS_KEY_SECRET=
ALI_SMS_SIGN_NAME=
ALI_SMS_TEMPLATE_CODE=
ALI_SMS_SCHEME_NAME=
ALI_SMS_CODE_LENGTH=6
ALI_SMS_VALID_TIME=300

# LLM
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
